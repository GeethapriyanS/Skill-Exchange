# Frontend environment variables
# Set the backend API base URL (include /api)
REACT_APP_API_URL=https://your-backend.example.com/api

# Socket.IO server URL (no /api)
REACT_APP_SOCKET_URL=https://your-backend.example.com

# Notes:
# - Replace `your-backend.example.com` with your deployed backend host.
# - If using localhost for development, use:
#   REACT_APP_API_URL=http://localhost:5000/api
#   REACT_APP_SOCKET_URL=http://localhost:5000
# - After editing `.env`, restart the frontend dev server so values are picked up.
